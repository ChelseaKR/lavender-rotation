# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.hypothesis/
dist/
build/

# Local cache (personal listening data — never committed; privacy: local-first)
data/*.db
data/*.sqlite
data/*.sqlite3

# Secrets — API keys live in the environment / .env, never in source
.env
*.secret

# Generated a11y artifacts that include timestamps are committed under docs/audits/
# but the raw browser dumps are not.
docs/audits/pa11y-raw.json
# coverage.xml is regenerable machine churn (pytest, see pyproject.toml), not a
# committed deliverable (unlike eval-report.json / the a11y dashboards).
docs/audits/coverage.xml
node_modules/

# OS
.DS_Store

# Generated upstream worklist: derived from a personal listening history
# (artist play counts), so it is local output, never a committed artifact.
upstream-worklist.md
upstream-worklist.html
# `lavender report --out` renders a real listener's picks — taste data, and the
# file says so in its own privacy footer. Local output, never committed.
queer-discoveries.html
*-discoveries.html

# Run manifests. They live under the resolved data directory, which is outside
# the repository by default — this covers the case where an operator points
# LAVENDER_DATA_DIR at the checkout. A manifest holds a listener's picks and
# their ranks, so it is local output for the same reason the report is.
runs/
data/runs/
